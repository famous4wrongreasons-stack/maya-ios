{
  "appId": "ru.mayaos.app",
  "appName": "MAYA OS",
  "webDir": "www",
  "server": {
    "hostname": "mayaos.ru",
    "iosScheme": "https",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "backgroundColor": "#0A84FF",
      "showSpinner": false,
      "launchAutoHide": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "none",
      "autoBackdropColor": "dom"
    }
  }
}
